{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": false,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@common/*": ["./src/common/*"],
      "@client/*": ["./src/client/*"],
      "@/*": ["./src/client/*"]
    }
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules", "dist", "dist-vp"]
}
